# Los comprobantes de pago contienen datos bancarios: NO se sirven por URL directa.
# Se entregan unicamente por payments/receiptImage?id=N, que exige sesion y alcance sobre el pago.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order Deny,Allow
    Deny from all
</IfModule>
