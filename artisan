#!/usr/bin/env php
<?php
/**
 * Script de conveniencia para comandos de desarrollo.
 */

$command = $argv[1] ?? 'serve';

if (in_array(strtolower($command), ['serve', 'server'])) {
    $host = '127.0.0.1';
    $port = '8000';
    
    // Permitir pasar opciones como --port=8080 o --host=0.0.0.0
    foreach ($argv as $arg) {
        if (str_starts_with($arg, '--port=')) {
            $port = substr($arg, 7);
        }
        if (str_starts_with($arg, '--host=')) {
            $host = substr($arg, 7);
        }
    }

    echo "========================================================\n";
    echo "  Escuela de Beisbol Menor Maporal - Servidor Local     \n";
    echo "========================================================\n";
    echo "Servidor corriendo en: http://{$host}:{$port}\n";
    echo "Presiona Ctrl+C para detener el servidor.\n\n";

    passthru(PHP_BINARY . " -S {$host}:{$port} router.php");
    exit(0);
}

echo "Uso: php artisan serve [--port=8000] [--host=127.0.0.1]\n";
exit(1);
